# Tell Them Studio — Production Environment Variables

# Cloud Runtime Configuration
NODE_ENV=production
PORT=8080
ALLOWED_ORIGINS=

# Google Gemini / Lyria API Credentials
GEMINI_API_KEY=
CREATIVE_MODEL=gemini-3.8-flash
TEXT_MODEL=gemini-3.8-flash
TTS_MODEL=gemini-3.8-flash-tts
# --- Phase 3: durable catalog & creator sessions (all server-side; never exposed to the browser) ---
# The catalog is OPTIONAL. Without it the studio runs in local-only/offline mode.
#
# Metadata store. Set DATABASE_URL for Postgres (production); otherwise a JSON-file store is used
# in CATALOG_DATA_DIR (default .data in development; ':memory:' = volatile, used by tests).
DATABASE_URL=
CATALOG_DATA_DIR=
# Signs the HttpOnly session cookie. REQUIRED in production, >= 32 random characters.
SESSION_SECRET=
# Audio object storage. Set S3_BUCKET for S3/R2/GCS-interop; otherwise audio goes to CATALOG_DATA_DIR.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional tuning
API_RATE_LIMIT=150
PUBLISH_RATE_LIMIT=10
SESSION_CREATE_LIMIT=20
S3_KEY_PREFIX=
DATABASE_POOL_MAX=10
DATABASE_SSL=
COOKIE_SECURE=
