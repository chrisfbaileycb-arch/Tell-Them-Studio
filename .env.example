# Required for AI generation (Music, Podcasts, Commercials, Cover Art, Creative Assistant)
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Optional Configuration (All have built-in local fallbacks out of the box)
# -----------------------------------------------------------------------------
# Extra origins allowed to call the API with cookies (comma-separated). Same-origin requests are
# always allowed. Leave unset unless the showcase or studio is hosted on another origin.
# ALLOWED_ORIGINS=https://showcase.example.com
# Number of proxy hops in front of the app, used for per-visitor rate limits and https detection.
# Defaults to 1 in production (Cloud Run, Render, Railway, Fly) and off in development.
# TRUST_PROXY=1
# CATALOG_DATA_DIR=./data
# COOKIE_SECURE=false
# SESSION_SECRET=
#
# Optional PostgreSQL Persistence (automatically falls back to FileCatalogRepository in ./data)
# DATABASE_URL=
# DATABASE_SSL=false
# DATABASE_POOL_MAX=10
#
# Optional S3-Compatible Object Storage (automatically falls back to LocalObjectStorage in ./data)
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_KEY_PREFIX=
#
# Optional Rate Limits & Model Overrides
# API_RATE_LIMIT=150
# PUBLISH_RATE_LIMIT=10
# SESSION_CREATE_LIMIT=20
# TEXT_MODEL=
# CREATIVE_MODEL=
# TTS_MODEL=